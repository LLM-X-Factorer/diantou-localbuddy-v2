{
  "name": "@diantou/localbuddy-v2",
  "version": "0.12.6",
  "private": true,
  "description": "Local-first multi-agent desktop runtime with remote LLM providers",
  "author": "Diantou Education",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/LLM-X-Factorer/diantou-localbuddy-v2.git"
  },
  "homepage": "https://github.com/LLM-X-Factorer/diantou-localbuddy-v2",
  "bugs": {
    "url": "https://github.com/LLM-X-Factorer/diantou-localbuddy-v2/issues"
  },
  "type": "module",
  "main": "dist/desktop/main.js",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:metadata": "node scripts/write-build-metadata.mjs",
    "build:core": "tsc -p tsconfig.json",
    "build:renderer": "vite build",
    "build": "pnpm build:metadata && pnpm build:renderer && pnpm build:core",
    "cli": "pnpm build && node dist/src/cli.js",
    "credentials:set": "pnpm build && node dist/src/credentials-cli.js",
    "update:stage": "pnpm build:core && node dist/src/update-cli.js",
    "update:sign": "node scripts/sign-update-manifest.mjs",
    "skill:sign": "node scripts/sign-skill-package.mjs",
    "mcp:revoke": "pnpm build:core && node dist/src/mcp-oauth-cli.js",
    "desktop": "pnpm build && electron .",
    "package:prepare": "pnpm build && node scripts/stage-playwright.mjs",
    "package:dir": "pnpm package:prepare && electron-forge package --platform=darwin --arch=arm64",
    "package:linux": "pnpm package:prepare && electron-forge package --platform=linux --arch=x64",
    "package:win": "pnpm package:prepare && electron-forge package --platform=win32 --arch=x64",
    "make:mac": "pnpm package:prepare && electron-forge make --platform=darwin --arch=arm64 && node scripts/make-dmg.mjs",
    "make:linux": "pnpm package:prepare && electron-forge make --platform=linux --arch=x64",
    "make:win": "pnpm package:prepare && electron-forge make --platform=win32 --arch=x64",
    "verify:first-run-package": "node scripts/verify-clean-first-launch.mjs",
    "verify:first-run-windows-installer": "pwsh -NoLogo -NoProfile -File scripts/verify-windows-installer-first-launch.ps1",
    "verify:windows-gray-installer": "pwsh -NoLogo -NoProfile -File scripts/verify-windows-installer-gray.ps1",
    "verify:windows-upgrade-installer": "pwsh -NoLogo -NoProfile -File scripts/verify-windows-installer-upgrade.ps1",
    "windows:canary": "pwsh -NoLogo -NoProfile -File scripts/sync-windows-canary.ps1",
    "benchmark:materialize": "node scripts/materialize-workbuddy-benchmark.mjs",
    "benchmark:trace": "pnpm build:core && node scripts/export-workbuddy-trace.mjs",
    "verify:mac-package": "node scripts/verify-macos-package.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test": "pnpm build:core && node --test dist/test/*.test.js",
    "check": "pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-deb": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-fuses": "7.11.2",
    "@electron/fuses": "2.1.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "^43.3.0",
    "lodash": "4.18.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "electron-squirrel-startup": "1.0.1",
    "fflate": "0.8.3",
    "playwright": "1.62.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "pnpm": {
    "overrides": {
      "nanoid": "3.3.18",
      "tar": "7.5.21",
      "tmp": "0.2.7"
    }
  }
}
